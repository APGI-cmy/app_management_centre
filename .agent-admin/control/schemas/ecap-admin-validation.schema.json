{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/APGI-cmy/app_management_centre/.agent-admin/control/schemas/ecap-admin-validation.schema.json",
  "title": "AMC ECAP Admin Validation",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "wave_id",
    "pr_number",
    "ecap_session_id",
    "validation_scope",
    "admin_checks",
    "artifact_paths_resolved",
    "scope_declaration_current",
    "pr_admin_json_current",
    "commit_state_verified",
    "substantive_readiness_judgment_made",
    "iaa_invoked_by_ecap",
    "foreman_qp_judgment_rewritten",
    "admin_validation_result",
    "blocking_admin_findings"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "wave_id": { "type": "string" },
    "pr_number": { "type": ["integer", "string"] },
    "ecap_session_id": { "type": "string" },
    "validation_scope": { "type": "array" },
    "admin_checks": { "type": "array" },
    "artifact_paths_resolved": { "type": "boolean" },
    "scope_declaration_current": { "type": "boolean" },
    "pr_admin_json_current": { "type": "boolean" },
    "commit_state_verified": { "type": "boolean" },
    "substantive_readiness_judgment_made": { "const": false },
    "iaa_invoked_by_ecap": { "const": false },
    "foreman_qp_judgment_rewritten": { "const": false },
    "admin_validation_result": { "enum": ["ADMIN_VALIDATED", "ADMIN_BLOCKED"] },
    "blocking_admin_findings": { "type": "array" }
  }
}

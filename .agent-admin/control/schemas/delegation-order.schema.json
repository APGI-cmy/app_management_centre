{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/APGI-cmy/app_management_centre/.agent-admin/control/schemas/delegation-order.schema.json",
  "title": "AMC Delegation Order Control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave_id",
    "pr_number",
    "prebrief_commit_sha",
    "builder_appointment_timestamp",
    "builder_appointment_commit_sha",
    "builder_agent",
    "builder_task_ref",
    "first_implementation_commit_sha",
    "qp_review_timestamp",
    "result"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "wave_id": { "type": "string", "minLength": 1 },
    "pr_number": { "type": ["integer", "string"] },
    "prebrief_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "builder_appointment_timestamp": { "type": "string", "format": "date-time" },
    "builder_appointment_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "builder_agent": { "type": "string", "minLength": 1 },
    "builder_task_ref": { "type": "string", "minLength": 1 },
    "first_implementation_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "qp_review_timestamp": { "type": "string", "format": "date-time" },
    "result": { "const": "DELEGATION_ORDER_VERIFIED" }
  }
}

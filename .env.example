# AMC environment template
# Purpose: Document all required and optional environment variables for AMC architecture validation.
# Governance source: ARCHITECTURE_COMPLETENESS_REQUIREMENTS.md v1.4 section 3.3.
# Values are placeholders only. Do not commit secrets.

# Purpose: Public Supabase project URL used by the browser client.
# Format: URL
# Required: YES
# Source: Owner-provided / Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co

# Purpose: Public Supabase anon key used by the browser client with RLS enforcement.
# Format: JWT-like public anon key
# Required: YES
# Source: Owner-provided / Supabase project settings
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Purpose: Privileged Supabase service role key used only by server-side routes/functions.
# Format: Secret token
# Required: YES
# Source: Owner-provided / Supabase project settings
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Purpose: URL of the deployed AMC application.
# Format: URL
# Required: YES
# Source: Platform-generated in Vercel or Owner-provided for non-Vercel hosting
NEXT_PUBLIC_APP_URL=https://amc.example.com

# Purpose: Vercel deployment URL for preview/production diagnostics.
# Format: URL
# Required: NO
# Source: Platform-generated
VERCEL_URL=https://amc-preview.example.vercel.app

# Purpose: AIMC gateway base URL. AMC must route all AI actions through AIMC only.
# Format: URL
# Required: YES
# Source: Owner-provided / AIMC deployment
AIMC_API_BASE_URL=https://aimc.example.com

# Purpose: Service token for AMC to call AIMC.
# Format: Secret bearer token
# Required: YES
# Source: Owner-provided / AIMC service identity
AIMC_SERVICE_TOKEN=replace_with_aimc_service_token

# Purpose: AIMCC read/status/governance notification base URL. AMC must not call AIMCC ingestion endpoints directly.
# Format: URL
# Required: YES
# Source: Owner-provided / AIMCC deployment
AIMCC_API_BASE_URL=https://aimcc.example.com

# Purpose: Service token for AMC to call AIMCC governed read/status interfaces.
# Format: Secret bearer token
# Required: YES
# Source: Owner-provided / AIMCC service identity
AIMCC_SERVICE_TOKEN=replace_with_aimcc_service_token

# Purpose: Knowledge Upload Centre submission base URL. AMC uploads must route through KUC.
# Format: URL
# Required: YES
# Source: Owner-provided / KUC deployment
KUC_API_BASE_URL=https://kuc.example.com

# Purpose: Service token for AMC to submit governed uploads through KUC.
# Format: Secret bearer token
# Required: YES
# Source: Owner-provided / KUC service identity
KUC_SERVICE_TOKEN=replace_with_kuc_service_token

# Purpose: Knowledge/memory read API base URL for provenance-required retrieval.
# Format: URL
# Required: YES
# Source: Owner-provided / knowledge-memory deployment
KNOWLEDGE_API_BASE_URL=https://knowledge.example.com

# Purpose: Service token for AMC knowledge/memory read-only access.
# Format: Secret bearer token
# Required: YES
# Source: Owner-provided / knowledge-memory service identity
KNOWLEDGE_SERVICE_TOKEN=replace_with_knowledge_service_token

# Purpose: Foreman dispatch/reporting base URL.
# Format: URL
# Required: YES
# Source: Owner-provided / Foreman deployment
FOREMAN_API_BASE_URL=https://foreman.example.com

# Purpose: Service token for AMC to dispatch governed intervention orders to Foreman.
# Format: Secret bearer token
# Required: YES
# Source: Owner-provided / Foreman service identity
FOREMAN_SERVICE_TOKEN=replace_with_foreman_service_token

# Purpose: Specialist agent gateway base URL for governed status/termination interactions.
# Format: URL
# Required: NO unless specialist-agent oversight is enabled
# Source: Owner-provided / specialist-agent deployment
SPECIALIST_AGENT_API_BASE_URL=https://agents.example.com

# Purpose: Service token for specialist-agent gateway interactions.
# Format: Secret bearer token
# Required: NO unless specialist-agent oversight is enabled
# Source: Owner-provided / specialist-agent service identity
SPECIALIST_AGENT_SERVICE_TOKEN=replace_with_specialist_agent_service_token

# Purpose: Alert escalation Level 1 timeout.
# Format: Integer minutes
# Required: YES
# Source: Owner-provided operational policy
ALERT_ESCALATION_LEVEL_1_MINUTES=30

# Purpose: Alert escalation Level 2 timeout.
# Format: Integer minutes
# Required: YES
# Source: Owner-provided operational policy
ALERT_ESCALATION_LEVEL_2_MINUTES=60

# Purpose: Reserved-matter approval timeout before ARC classification.
# Format: Integer minutes
# Required: YES
# Source: Owner-provided operational policy
ARC_RESERVED_MATTER_TIMEOUT_MINUTES=120

# Purpose: Boundary-bypass timeout before ARC escalation.
# Format: Integer minutes
# Required: YES
# Source: Owner-provided operational policy
ARC_BOUNDARY_BYPASS_TIMEOUT_MINUTES=120

# Purpose: ARC stale-item SLA before reminder/escalation alert.
# Format: Integer minutes
# Required: YES
# Source: Owner-provided operational policy
ARC_STALE_ITEM_SLA_MINUTES=240

# Purpose: AIMCC upload quota warning threshold.
# Format: Integer percent 0-100
# Required: YES
# Source: Owner-provided operational policy
QUOTA_WARNING_THRESHOLD_PERCENT=80

# Purpose: AIMCC upload quota critical threshold.
# Format: Integer percent 0-100
# Required: YES
# Source: Owner-provided operational policy
QUOTA_CRITICAL_THRESHOLD_PERCENT=95

# Purpose: Health poll interval for external dependencies.
# Format: Integer seconds
# Required: YES
# Source: Owner-provided operational policy
HEALTH_POLL_INTERVAL_SECONDS=30

# Purpose: Web Push VAPID public key for browser notifications.
# Format: Public key string
# Required: NO unless web push is enabled
# Source: Application-generated
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key

# Purpose: Web Push VAPID private key for server-side notification dispatch.
# Format: Secret private key string
# Required: NO unless web push is enabled
# Source: Application-generated
VAPID_PRIVATE_KEY=replace_with_vapid_private_key

# Purpose: Firebase Cloud Messaging server credential reference for Android push.
# Format: Secret or platform secret reference
# Required: NO unless Android push is enabled
# Source: Owner-provided / Firebase project
FCM_SERVER_KEY=replace_with_fcm_server_key

# Purpose: Apple Push Notification Service key reference for iOS push.
# Format: Secret or platform secret reference
# Required: NO unless iOS push is enabled
# Source: Owner-provided / Apple developer account
APNS_KEY=replace_with_apns_key
